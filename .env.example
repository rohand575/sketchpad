# Firebase web config. Copy this file to `.env.local` and paste your keys.
# Leave blank / delete .env.local to run the app fully local (cloud features hidden).
# Find these in Firebase Console → Project settings → Your apps → SDK setup and configuration.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base path for GitHub Pages (e.g. /sketchpad/). Optional; defaults to /sketchpad/.
# VITE_BASE=/sketchpad/
